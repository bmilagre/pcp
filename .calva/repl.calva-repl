(defn quadraticFormula [a b c]
  (if (not (quadraticFormulaSolvable a b c))
    []
    (let [d (discriminant a b c)]
      (if (= d 0)
        [(/ (- b) (* 2 a))]
        (let [sqrt-d (Math/sqrt d)]
          [(/ (+ (- b) sqrt-d) (* 2 a))
           (/ (- (- b) sqrt-d) (* 2 a))])))))
